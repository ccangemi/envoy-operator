# Bill of materials for one operator release.
# Change the versions here, then run `make update-upstream bundle` and commit
# the result. docs/development.md describes the steps.

# Operator (bundle) version and OLM channel.
OPERATOR_VERSION=0.1.0
CHANNEL=alpha
# The bundle that this version replaces. Empty for the first release.
REPLACES=

# The upstream chart that the operator installs, from oci://docker.io/envoyproxy.
CHART_NAME=gateway-helm
CHART_VERSION=v1.9.3
# The chart with the Envoy Gateway CRDs, same version.
CRDS_CHART_NAME=gateway-crds-helm

# Image of the operator, without tag. The release workflow builds and pushes
# <repository>:v<OPERATOR_VERSION> and pins its digest in the released bundle.
# It must be a public repository on quay.io (see docs/development.md).
OPERATOR_IMAGE_REPOSITORY=quay.io/gateway-operators/envoy-gateway-operator

# OpenShift versions that the bundle supports (OLM annotation syntax).
# =v4.22 means only OpenShift 4.22; v4.22 would mean 4.22 and later.
OPENSHIFT_VERSIONS==v4.22

# The namespace that the ClusterServiceVersion suggests.
OPERATOR_NAMESPACE=envoy-gateway-system
