# Bill of materials for one operator release.
# This is the only file to change when you move to new upstream versions.
# After a change, run `make bundle` and commit the result.

# Operator (bundle) version and OLM channel.
OPERATOR_VERSION=0.1.0
CHANNEL=alpha
# The bundle that this version replaces. Empty for the first release.
REPLACES=

# Upstream versions.
EG_VERSION=v1.9.3
AR_VERSION=v1.2.0

# Image for the agent router bootstrap init container (Python standard library
# only). It is public, multi-architecture and runs as a non-root user.
# The tag moves often, so the generator always pins it by digest.
BOOTSTRAP_IMAGE=registry.access.redhat.com/ubi9/python-312-minimal:1

# OpenShift versions that the bundle supports (OLM annotation syntax).
OPENSHIFT_VERSIONS=v4.22

# The namespace where the operator must run. The agent router webhook name and
# the Envoy Gateway extension manager address depend on it.
OPERATOR_NAMESPACE=envoy-gateway-system
